<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions as backup_rules.xml, for cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="talks" />
        <exclude domain="file" path="custom_bell" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="talks" />
        <exclude domain="file" path="custom_bell" />
    </device-transfer>
</data-extraction-rules>
